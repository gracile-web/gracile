{
  "extends": "@gracile/gracile/tsconfigs/strictest",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,

    "jsx": "react-native",
    "jsxImportSource": "jsx-forge",
    "plugins": [
      {
        "transform": "jsx-forge/transform"
      }
    ],

    "resolveJsonModule": true
  },

  "include": ["src/**/*"]
}
