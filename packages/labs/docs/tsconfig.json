{
  "extends": "@gracile/gracile/tsconfigs/strictest",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,

    "jsx": "react-native",
    "jsxImportSource": "jsx-forge",
    "plugins": [
      // {
      //   "name": "web-elements-analyzer"
      // },
      // {
      //   "transform": "web-elements-analyzer/transformer",
      //   "transformProgram": true
      // },
      {
        "transform": "jsx-forge/transform"
      },
      {
        "transform": "@lit/ts-transformers",
        "import": "idiomaticDecoratorsTransformer"
      }
    ],

    "resolveJsonModule": true
  },

  "include": ["src/**/*"]
}
